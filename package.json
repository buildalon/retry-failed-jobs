{
  "name": "retry-failed-jobs",
  "version": "1.0.0",
  "description": "A GitHub Action to rerun the failed jobs of a finished workflow run when every failure is marked as retryable.",
  "author": "buildalon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildalon/retry-failed-jobs.git"
  },
  "bugs": {
    "url": "https://github.com/buildalon/retry-failed-jobs/issues"
  },
  "homepage": "https://github.com/buildalon/retry-failed-jobs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "esbuild": "^0.28.2",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run clean && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --sourcemap --log-level=warning",
    "clean": "npm install && shx rm -rf dist/ out/ node_modules/ && npm ci",
    "typecheck": "tsc --noEmit"
  }
}
